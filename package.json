        {
          "command": "appleContainer.mount.reveal",
          "when": "false"
        },
        {
          "command": "appleContainer.container.edit",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "appleContainer.refresh",
          "when": "view =~ /^appleContainer\\./",
          "group": "navigation@9"
        },
        {
          "command": "appleContainer.container.prune",
          "when": "view == appleContainer.containers",
          "group": "navigation@1"
        },
        {
          "command": "appleContainer.image.pull",
          "when": "view == appleContainer.images",
          "group": "navigation@1"
        },
        {
          "command": "appleContainer.image.build",
          "when": "view == appleContainer.images",
          "group": "navigation@2"
        },
        {
          "command": "appleContainer.image.prune",
          "when": "view == appleContainer.images",
          "group": "navigation@3"
        },
        {
          "command": "appleContainer.network.create",
          "when": "view == appleContainer.networks",
          "group": "navigation@1"
        },
        {
          "command": "appleContainer.network.prune",
          "when": "view == appleContainer.networks",
          "group": "navigation@2"
        },
        {
          "command": "appleContainer.volume.create",
          "when": "view == appleContainer.volumes",
          "group": "navigation@1"
        },
        {
          "command": "appleContainer.volume.prune",
          "when": "view == appleContainer.volumes",
          "group": "navigation@2"
        },
        {
          "command": "appleContainer.registry.login",
          "when": "view == appleContainer.registries",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "appleContainer.container.start",
          "when": "viewItem =~ /^container\\.stopped/",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.container.stop",
          "when": "viewItem =~ /^container\\.running/",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.container.exec",
          "when": "viewItem =~ /^container\\.running/",
          "group": "inline@2"
        },
        {
          "command": "appleContainer.container.start",
          "when": "viewItem =~ /^container\\.stopped/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "appleContainer.container.stop",
          "when": "viewItem =~ /^container\\.running/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "appleContainer.container.restart",
          "when": "viewItem =~ /^container\\.running/",
          "group": "1_lifecycle@2"
        },
        {
          "command": "appleContainer.container.kill",
          "when": "viewItem =~ /^container\\.running/",
          "group": "1_lifecycle@3"
        },
        {
          "command": "appleContainer.container.exec",
          "when": "viewItem =~ /^container\\.running/",
          "group": "2_view@1"
        },
        {
          "command": "appleContainer.container.logs",
          "when": "viewItem =~ /^container\\./",
          "group": "2_view@2"
        },
        {
          "command": "appleContainer.container.bootLogs",
          "when": "viewItem =~ /^container\\./",
          "group": "2_view@3"
        },
        {
          "command": "appleContainer.container.stats",
          "when": "viewItem =~ /^container\\.running/",
          "group": "2_view@4"
        },
        {
          "command": "appleContainer.container.inspect",
          "when": "viewItem =~ /^container\\./",
          "group": "2_view@5"
        },
        {
          "command": "appleContainer.container.copyId",
          "when": "viewItem =~ /^container\\./",
          "group": "3_copy@1"
        },
        {
          "command": "appleContainer.container.copyIp",
          "when": "viewItem =~ /^container\\.running/",
          "group": "3_copy@2"
        },
        {
          "command": "appleContainer.container.delete",
          "when": "viewItem =~ /^container\\./",
          "group": "9_delete@1"
        },
        {
          "command": "appleContainer.image.run",
          "when": "viewItem == image",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.image.run",
          "when": "viewItem == image",
          "group": "1_run@1"
        },
        {
          "command": "appleContainer.image.tag",
          "when": "viewItem == image",
          "group": "2_view@1"
        },
        {
          "command": "appleContainer.image.inspect",
          "when": "viewItem == image",
          "group": "2_view@2"
        },
        {
          "command": "appleContainer.image.copyName",
          "when": "viewItem == image",
          "group": "3_copy@1"
        },
        {
          "command": "appleContainer.image.delete",
          "when": "viewItem == image",
          "group": "9_delete@1"
        },
        {
          "command": "appleContainer.network.inspect",
          "when": "viewItem =~ /^network/",
          "group": "2_view@1"
        },
        {
          "command": "appleContainer.network.delete",
          "when": "viewItem == network",
          "group": "9_delete@1"
        },
        {
          "command": "appleContainer.volume.inspect",
          "when": "viewItem == volume",
          "group": "2_view@1"
        },
        {
          "command": "appleContainer.volume.delete",
          "when": "viewItem == volume",
          "group": "9_delete@1"
        },
        {
          "command": "appleContainer.registry.logout",
          "when": "viewItem == registry",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.registry.copyHostname",
          "when": "viewItem == registry",
          "group": "3_copy@1"
        },
        {
          "command": "appleContainer.registry.logout",
          "when": "viewItem == registry",
          "group": "9_delete@1"
        },
        {
          "command": "appleContainer.compose.start",
          "when": "viewItem == composeProject",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.compose.stop",
          "when": "viewItem == composeProject",
          "group": "inline@2"
        },
        {
          "command": "appleContainer.compose.start",
          "when": "viewItem == composeProject",
          "group": "1_lifecycle@1"
        },
        {
          "command": "appleContainer.compose.stop",
          "when": "viewItem == composeProject",
          "group": "1_lifecycle@2"
        },
        {
          "command": "appleContainer.compose.restart",
          "when": "viewItem == composeProject",
          "group": "1_lifecycle@3"
        },
        {
          "command": "appleContainer.compose.up",
          "when": "viewItem == composeProject",
          "group": "2_compose@1"
        },
        {
          "command": "appleContainer.compose.down",
          "when": "viewItem == composeProject",
          "group": "2_compose@2"
        },
        {
          "command": "appleContainer.compose.openFile",
          "when": "viewItem == composeProject",
          "group": "2_compose@3"
        },
        {
          "command": "appleContainer.compose.delete",
          "when": "viewItem == composeProject",
          "group": "9_delete@1"
        },
        {
          "command": "appleContainer.port.open",
          "when": "viewItem == port.tcp",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.port.open",
          "when": "viewItem == port.tcp",
          "group": "1_open@1"
        },
        {
          "command": "appleContainer.port.copyUrl",
          "when": "viewItem =~ /^port/",
          "group": "3_copy@1"
        },
        {
          "command": "appleContainer.mount.reveal",
          "when": "viewItem == mount.bind",
          "group": "inline@1"
        },
        {
          "command": "appleContainer.mount.reveal",
          "when": "viewItem == mount.bind",
          "group": "1_open@1"
        },
        {
          "command": "appleContainer.container.edit",
          "when": "viewItem =~ /^container\\.(running|stopped)$/",
          "group": "1_lifecycle@9"
        }
      ],
      "explorer/context": [
        {
          "command": "appleContainer.image.build",
          "when": "resourceFilename =~ /^(Dockerfile|Containerfile)(\\..*)?$|\\.(Dockerfile|Containerfile)$/",
          "group": "apple-container@1"
        },
        {
          "command": "appleContainer.compose.up",
          "when": "resourceFilename =~ /^(docker-)?compose(\\..+)?\\.ya?ml$/",
          "group": "apple-container@2"
        },
        {
          "command": "appleContainer.compose.down",
          "when": "resourceFilename =~ /^(docker-)?compose(\\..+)?\\.ya?ml$/",
          "group": "apple-container@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "appleContainer.compose.up",
          "when": "resourceFilename =~ /^(docker-)?compose(\\..+)?\\.ya?ml$/",
          "group": "apple-container@1"
        },
        {
          "command": "appleContainer.compose.down",
          "when": "resourceFilename =~ /^(docker-)?compose(\\..+)?\\.ya?ml$/",
          "group": "apple-container@2"
        }
      ]
    },
    "configuration": {
      "title": "%category%",
      "properties": {
        "appleContainer.path": {
          "type": "string",
          "default": "container",
          "markdownDescription": "%config.path%",
          "scope": "machine"
        },
        "appleContainer.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%config.refreshInterval%"
        },
        "appleContainer.execShell": {
          "type": "string",
          "default": "/bin/sh",
          "markdownDescription": "%config.execShell%"
        },
        "appleContainer.logTail": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "markdownDescription": "%config.logTail%"
        },
        "appleContainer.composePath": {
          "type": "string",
          "default": "container-compose",
          "scope": "machine",
          "markdownDescription": "%config.composePath%"
        },
        "appleContainer.statsInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "markdownDescription": "%config.statsInterval%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production && npm --prefix webview-ui run build",
    "build": "node esbuild.mjs && npm --prefix webview-ui run build",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && npm --prefix webview-ui run typecheck",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "test": "npm run typecheck && npm run check:l10n && npm run test:unit",
    "package": "vsce package --no-dependencies --target darwin-arm64",
    "publish": "vsce publish --no-dependencies --target darwin-arm64",
    "check:l10n": "node scripts/check-l10n.mjs",
    "test:e2e": "npm run build && npm run compile-tests && node out/test/runE2E.js",
    "watch:webview": "npm --prefix webview-ui run dev",
    "postinstall": "npm --prefix webview-ui install",
    "demo": "npm run build && npm run compile-tests && node out/test/demo/runDemo.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "gifenc": "1.0.3",
    "mocha": "^12.0.3",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2"
  },
  "l10n": "./l10n"
}
