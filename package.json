{
  "name": "apple-container-tools",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "fqix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fqix/mac-container.git"
  },
  "bugs": {
    "url": "https://github.com/fqix/mac-container/issues"
  },
  "homepage": "https://github.com/fqix/mac-container#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#4338CA",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "container",
    "apple",
    "macos",
    "docker",
    "oci"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "appleContainer",
          "title": "%viewsContainer.title%",
          "icon": "resources/container.svg"
        }
      ]
    },
    "views": {
      "appleContainer": [
        {
          "id": "appleContainer.containers",
          "name": "%view.containers%"
        },
        {
          "id": "appleContainer.images",
          "name": "%view.images%"
        },
        {
          "id": "appleContainer.networks",
          "name": "%view.networks%",
          "visibility": "collapsed"
        },
        {
          "id": "appleContainer.volumes",
          "name": "%view.volumes%",
          "visibility": "collapsed"
        },
        {
          "id": "appleContainer.registries",
          "name": "%view.registries%",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "appleContainer.containers",
        "contents": "%welcome.cliMissing%",
        "when": "appleContainer.cliMissing"
      },
      {
        "view": "appleContainer.containers",
        "contents": "%welcome.serviceStopped%",
        "when": "!appleContainer.cliMissing && appleContainer.serviceStopped"
      },
      {
        "view": "appleContainer.containers",
        "contents": "%welcome.noContainers%",
        "when": "!appleContainer.cliMissing && !appleContainer.serviceStopped"
      },
      {
        "view": "appleContainer.images",
        "contents": "%welcome.noImages%",
        "when": "!appleContainer.cliMissing && !appleContainer.serviceStopped"
      },
      {
        "view": "appleContainer.volumes",
        "contents": "%welcome.noVolumes%",
        "when": "!appleContainer.cliMissing && !appleContainer.serviceStopped"
      },
      {
        "view": "appleContainer.registries",
        "contents": "%welcome.noRegistries%",
        "when": "!appleContainer.cliMissing && !appleContainer.serviceStopped"
      }
    ],
    "commands": [
      {
        "command": "appleContainer.refresh",
        "title": "%command.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "appleContainer.container.start",
        "title": "%command.container.start%",
        "category": "%category%",
        "icon": "$(debug-start)"
      },
      {
        "command": "appleContainer.container.stop",
        "title": "%command.container.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "appleContainer.container.restart",
        "title": "%command.container.restart%",
        "category": "%category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "appleContainer.container.kill",
        "title": "%command.container.kill%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.container.delete",
        "title": "%command.container.delete%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "appleContainer.container.logs",
        "title": "%command.container.logs%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "appleContainer.container.bootLogs",
        "title": "%command.container.bootLogs%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.container.exec",
        "title": "%command.container.exec%",
        "category": "%category%",
        "icon": "$(terminal)"
      },
      {
        "command": "appleContainer.container.inspect",
        "title": "%command.container.inspect%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.container.stats",
        "title": "%command.container.stats%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.container.copyId",
        "title": "%command.container.copyId%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.container.copyIp",
        "title": "%command.container.copyIp%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.container.prune",
        "title": "%command.container.prune%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "appleContainer.image.pull",
        "title": "%command.image.pull%",
        "category": "%category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "appleContainer.image.build",
        "title": "%command.image.build%",
        "category": "%category%",
        "icon": "$(tools)"
      },
      {
        "command": "appleContainer.image.run",
