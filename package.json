      {
        "command": "appleContainer.image.tag",
        "title": "%command.image.tag%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.image.inspect",
        "title": "%command.image.inspect%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.image.copyName",
        "title": "%command.image.copyName%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.image.delete",
        "title": "%command.image.delete%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "appleContainer.image.prune",
        "title": "%command.image.prune%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "appleContainer.network.create",
        "title": "%command.network.create%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "appleContainer.network.inspect",
        "title": "%command.network.inspect%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.network.delete",
        "title": "%command.network.delete%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "appleContainer.network.prune",
        "title": "%command.network.prune%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "appleContainer.volume.create",
        "title": "%command.volume.create%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "appleContainer.volume.inspect",
        "title": "%command.volume.inspect%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.volume.delete",
        "title": "%command.volume.delete%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "appleContainer.volume.prune",
        "title": "%command.volume.prune%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "appleContainer.system.start",
        "title": "%command.system.start%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.system.stop",
        "title": "%command.system.stop%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.system.status",
        "title": "%command.system.status%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.system.df",
        "title": "%command.system.df%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.system.logs",
        "title": "%command.system.logs%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.system.menu",
        "title": "%command.system.menu%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.registry.login",
        "title": "%command.registry.login%",
        "category": "%category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "appleContainer.registry.logout",
        "title": "%command.registry.logout%",
        "category": "%category%",
        "icon": "$(sign-out)"
      },
      {
        "command": "appleContainer.registry.copyHostname",
        "title": "%command.registry.copyHostname%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.compose.up",
        "title": "%command.compose.up%",
        "category": "%category%",
        "icon": "$(run-all)"
      },
      {
        "command": "appleContainer.compose.down",
        "title": "%command.compose.down%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "appleContainer.compose.start",
        "title": "%command.compose.start%",
        "category": "%category%",
        "icon": "$(debug-start)"
      },
      {
        "command": "appleContainer.compose.stop",
        "title": "%command.compose.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "appleContainer.compose.restart",
        "title": "%command.compose.restart%",
        "category": "%category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "appleContainer.compose.delete",
        "title": "%command.compose.delete%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "appleContainer.compose.openFile",
        "title": "%command.compose.openFile%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "appleContainer.port.open",
        "title": "%command.port.open%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "appleContainer.port.copyUrl",
        "title": "%command.port.copyUrl%",
        "category": "%category%"
      },
      {
        "command": "appleContainer.mount.reveal",
        "title": "%command.mount.reveal%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "appleContainer.container.edit",
        "title": "%command.container.edit%",
        "category": "%category%",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "appleContainer.container.start",
          "when": "false"
        },
        {
          "command": "appleContainer.container.stop",
          "when": "false"
        },
        {
          "command": "appleContainer.container.restart",
          "when": "false"
        },
        {
          "command": "appleContainer.container.kill",
          "when": "false"
        },
        {
          "command": "appleContainer.container.delete",
          "when": "false"
        },
        {
          "command": "appleContainer.container.logs",
          "when": "false"
        },
        {
          "command": "appleContainer.container.bootLogs",
